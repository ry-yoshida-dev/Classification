import numpy as np
from numpy.typing import ArrayLike, NDArray

def accuracy_score(y_true: ArrayLike, y_pred: ArrayLike) -> float: ...
def average_precision_score(y_true: ArrayLike, y_score: ArrayLike) -> float: ...
def balanced_accuracy_score(y_true: ArrayLike, y_pred: ArrayLike) -> float: ...
def cohen_kappa_score(y1: ArrayLike, y2: ArrayLike) -> float: ...
def confusion_matrix(
    y_true: ArrayLike, y_pred: ArrayLike, *, labels: ArrayLike | None = None
) -> NDArray[np.int64]: ...
def f1_score(
    y_true: ArrayLike, y_pred: ArrayLike, *, average: str, zero_division: float = 0
) -> float: ...
def log_loss(
    y_true: ArrayLike, y_pred: ArrayLike, *, labels: ArrayLike | None = None
) -> float: ...
def matthews_corrcoef(y_true: ArrayLike, y_pred: ArrayLike) -> float: ...
def precision_recall_fscore_support(
    y_true: ArrayLike,
    y_pred: ArrayLike,
    *,
    labels: ArrayLike | None = None,
    average: None = None,
    zero_division: float = 0,
) -> tuple[
    NDArray[np.floating],
    NDArray[np.floating],
    NDArray[np.floating],
    NDArray[np.int64],
]: ...
def roc_auc_score(y_true: ArrayLike, y_score: ArrayLike) -> float: ...
